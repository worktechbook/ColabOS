def _install_svc_shim():
    svc_dst = os.path.join(BIN_DIR, "svc")
    svc_src = os.path.join(BASE, "engine", "svc")
    shim = "#!/bin/sh\nexec python3 %s \"$@\"\n" % shlex.quote(svc_src)
    try:
        atomic_write(svc_dst, shim, mode=0o755)
        return True
    except Exception as e:
        print(f"[svc] warn: could not install shim {svc_dst}: {e}")
        return False

def write_motd():
    """One-line ColabOS status printed on every interactive SSH login (sub-50ms, no Drive FUSE)."""
    motd = f"""# ColabOS MOTD (auto-generated — prints a one-line status banner on interactive shells)
case "$-" in *i*) ;; *) return ;; esac
if [ -t 1 ] && [ -z "${{COLABOS_MOTD_SHOWN:-}}" ]; then
  export COLABOS_MOTD_SHOWN=1
  _co_h=$(hostname -s 2>/dev/null)
  _co_t4=""
  command -v tailscale >/dev/null 2>&1 && {{
    _co_self=$(timeout 2 tailscale ip -4 2>/dev/null | head -1)
    _co_st=$(timeout 2 tailscale status 2>/dev/null)
    _co_peers=$(printf '%s' "$_co_st" | awk 'NR>1 && $1 ~ /^100\\./ && $2 != "Mullvad" {{n++}} END {{print n+0}}')
    _co_t4=" | tailnet: ${{_co_self:-?}} (${{_co_peers}} peers)"
  }}
  _co_up=$(awk '{{printf int($1/60)"m"}}' /proc/uptime 2>/dev/null)
  _co_nbins=$(ls /usr/local/bin/ 2>/dev/null | wc -l | tr -d ' ')
  printf "\\033[1;36m[ ColabOS v{VERSION} | %s | %s | up %s | %s bins%s ]\\033[0m\\n" \\
    "${{_co_h:-?}}" "$(date +%H:%M)" "${{_co_up:-?}}" "${{_co_nbins:-0}}" "${{_co_t4}}"
  unset _co_h _co_t4 _co_self _co_peers _co_st _co_up _co_nbins
fi
"""
    try:
        atomic_write(MOTD_D, motd, mode=0o644)
        return True
    except Exception as e:
        print(f"[svc] warn: could not write motd: {e}")
        return False

def collect_all_bins_and_env():
    bins = []; envs = {}
    for name, cfg in get_apps():
        # Server bins (tailscale/tailscaled) stay symlinked but get no
        # snapshot wrapper — servers have no update verbs and must not
        # trigger `svc snapshot` on every invocation.
        is_server = cfg.get("app", {}).get("type") == "server"
        if not is_server:
            for b in cfg.get("artifact", {}).get("bins", []):
                bins.append((b, name))
        for k, v in cfg.get("env", {}).items():
            envs[k] = v
    seen = set(); out_bins = []
    for b, app in bins:
        if b not in seen:
            seen.add(b); out_bins.append((b, app))
    return out_bins, envs

def write_profile():
    """Regenerate /etc/profile.d/colabos.sh (auto-generated shell wrappers)."""
    bins, envs = collect_all_bins_and_env()
    safe_bins = []
    for b, app in bins:
        if not _RE_BIN.match(str(b)):
            print(f"[svc] WARN: skipping invalid binary name in profile: {b!r}")
            continue
        safe_bins.append((b, app))
    safe_env_lines = []
    for k, v in envs.items():
        if not _RE_ENV_KEY.match(str(k)):
            print(f"[svc] WARN: skipping invalid env key in profile: {k!r}")
            continue
        safe_env_lines.append(f"export {k}={shlex.quote(str(v))}")
    case_body = "\n".join(f'      {shlex.quote(b)}) app={shlex.quote(app)} ;;' for (b, app) in safe_bins)
    env_lines = "\n".join(safe_env_lines)
    path_line = 'export PATH=/usr/local/bin:$PATH'
    tail_default = '' if 'TAILSCALE_HOSTNAME' in envs else 'export TAILSCALE_HOSTNAME="${TAILSCALE_HOSTNAME:-colabos-node}"\n'
    noop_pat = "|".join(sorted(NOOP_FLAGS))
    verb_pat = "|".join(f'" {v} "' for v in sorted(UPDATE_VERBS))
    snap_lock_dir = shlex.quote(os.path.dirname(WRAP_SNAPSHOT_LOCK) or "/tmp")
    snap_lock = shlex.quote(WRAP_SNAPSHOT_LOCK)
    contents = f"""# ColabOS profile (auto-generated by `svc bootstrap` - do not hand-edit)
{path_line}
{env_lines}
{tail_default}
# Generic snapshot-aware wrapper.
_colabos_wrap() {{
  local bin="$1"; shift
  local app=""
  case "$bin" in
{case_body}
      *) app="" ;;
  esac
  local cmd=$(type -P -- "$bin" 2>/dev/null || command -v -- "$bin" 2>/dev/null || true)
  # Follow symlinks (-L) so native updaters modifying the store target are detected.
  local mt1=""; [ -n "$cmd" ] && [ -e "$cmd" ] && mt1=$(stat -L -c %.9Y "$cmd" 2>/dev/null || stat -L -f %m "$cmd" 2>/dev/null || true)
  command "$bin" "$@"; local s=$?
  if [ -z "$app" ]; then return $s; fi
  local do_snap=0
  local verb="${{1:-}}"
  local verb2="${{1:-}} ${{2:-}}"
  case " $verb " in
    {verb_pat} )
      local noop=0
      for a in "$@"; do
        case "$a" in
          {noop_pat}) noop=1 ;;
        esac
      done
      [ $noop -eq 0 ] && [ $s -eq 0 ] && do_snap=1
      ;;
  esac
  if [ $do_snap -eq 0 ] && [ "$verb2" = "self update" ] && [ $s -eq 0 ]; then
    do_snap=1
  fi
  if [ $do_snap -eq 0 ] && [ -n "$mt1" ] && [ -n "$cmd" ] && [ -e "$cmd" ]; then
    local mt2=$(stat -L -c %.9Y "$cmd" 2>/dev/null || stat -L -f %m "$cmd" 2>/dev/null || true)
    [ "$mt1" != "$mt2" ] && do_snap=1
  fi
  if [ $do_snap -eq 1 ]; then
    mkdir -p {snap_lock_dir} 2>/dev/null || true
    (
      flock -n 9 || exit 0
      echo "[colabos] snapshot $app"
      svc snapshot "$app" 2>&1
    ) 9>{snap_lock}
  fi
  return $s
}}
"""
    for b, _ in safe_bins:
        contents += f"\n{b}() {{ _colabos_wrap {shlex.quote(b)} \"$@\"; }}\n"
    try:
        _install_svc_shim()
        atomic_write(PROFILE_D, contents, mode=0o644)
        write_motd()
        print(f"[svc] wrote profile with {len(safe_bins)} wrapper(s) -> {PROFILE_D}")
        return True
    except Exception as e:
        print(f"[svc] warn: could not write profile {PROFILE_D}: {e}")
        return False

# --------------------------------------------------------------------------- #
# Bin resolver                                                                 #
# --------------------------------------------------------------------------- #
def find_bin(live_link, b):
    """Resolve a declared binary inside a store tree.

    Candidates are sorted so the result is deterministic when several
    matches exist at the same depth (glob order is filesystem-dependent).
    """
    for depth in range(4):
        cands = sorted(glob.glob(os.path.join(live_link, "*/"*depth, "bin", b)))
        for c in cands:
            if os.path.isfile(c) and os.access(c, os.X_OK):
                return c
    return None

# --------------------------------------------------------------------------- #
# Install                                                                      #
# --------------------------------------------------------------------------- #
def install_app(name, *, quiet=False, force=False):
    """Install one app from its Drive artifact.

    force=True re-extracts the artifact even when the store directory
    already exists. This is the repair path for a corrupted or
    tampered store: without it, a corrupted tree can never be healed.
    """
    def log(*a):
        if not quiet: print(*a, flush=True)
    try:
        _validate_basename(name, "app name")
    except ValueError as e:
        log(f"ERROR: {e}"); return False
    cfg_path = os.path.join(BASE, "apps", f"{name}.toml")
    if not os.path.exists(cfg_path):
        log(f"ERROR: {cfg_path} not found"); return False
    cfg = load_toml(cfg_path)
    if not check_schema(cfg, name): return False
    src = artifact_path(cfg, name)
    if not src or not os.path.exists(src):
        log(f"ERROR: artifact missing for {name} (expected {src})"); return False

    # [artifact-digest] Verify the tarball digest BEFORE extracting it.
    # The 16-hex in the filename hashes the extracted tree, not the
    # tarball, so it cannot detect a corrupted or tampered download.
    # Fails closed: a mismatch aborts the install.
    ok, msg = verify_artifact_digest(cfg, name, src)
    if not ok:
        log(f"ERROR: {name} artifact digest verification failed: {msg}")
        return False
    if not msg.startswith("no digest"):
        log(f"[svc] digest {name}: {msg}")

    target_store = store_dir_for(cfg, name)
    live_link   = os.path.join(OPT, name)
    os.makedirs(STORE_OPT, exist_ok=True)
    os.makedirs(OPT, exist_ok=True)

    # Cold extract (or forced re-extract).
    if target_store and (force or not os.path.exists(target_store)):
        tmp = target_store + ".tmp"
        shutil.rmtree(tmp, ignore_errors=True)
        os.makedirs(tmp, exist_ok=True)
        size_mb = os.path.getsize(src) / (1024*1024)
        log(f"[svc] extract {os.path.basename(src)} ({size_mb:.0f} MiB) -> {target_store}")
        t0 = time.time()
        res = subprocess.run(["tar", "--no-same-owner", "-I", f"zstd {ZSTD_DECOMPRESS}", "-xf", src, "-C", tmp])
        if res.returncode != 0:
            log(f"ERROR: extract failed for {src}")
            shutil.rmtree(tmp, ignore_errors=True); return False
        # [artifact-digest] Verify the freshly extracted tree against the
        # manifest hash (which is computed with hash_exclude applied). This
        # catches a tarball whose contents do not match the hash in its name.
        #
        # [chmod-before-hash] The content hash covers tar metadata, which
        # includes the file mode. The declared binaries are chmod'ed to
        # 0755 BEFORE the tree is hashed, so an archived 0644 binary does
        # not produce a hash mismatch on the next doctor run.
        for b in cfg.get("artifact", {}).get("bins", []):
            if not _RE_BIN.match(str(b)):
                log(f"ERROR: invalid binary name {b!r} in {name}.toml")
                shutil.rmtree(tmp, ignore_errors=True); return False
            for depth in range(4):
                for c in sorted(glob.glob(os.path.join(tmp, "*/"*depth, "bin", b))):
                    if os.path.isfile(c):
                        try: os.chmod(c, 0o755)
                        except OSError: pass
        expected = os.path.basename(target_store).rsplit("-", 1)[-1]
        try:
            actual = sha16_of_dir(tmp, hash_excludes(cfg))
        except RuntimeError as e:
            log(f"ERROR: {name} could not hash extracted tree: {e}")
            shutil.rmtree(tmp, ignore_errors=True); return False
        if expected and actual != expected:
            log(f"ERROR: {name} extracted tree hash mismatch (expected {expected}, got {actual})")
            shutil.rmtree(tmp, ignore_errors=True); return False
        # [atomic-store] Swap the freshly verified tree into place. The
        # old directory is removed only after the new one is in place, so
        # a failed extraction never destroys a working install.
        if os.path.exists(target_store):
            stale = target_store + ".stale"
            shutil.rmtree(stale, ignore_errors=True)
            os.rename(target_store, stale)
            try:
                os.rename(tmp, target_store)
            except Exception:
                os.rename(stale, target_store)   # restore the old tree
                raise
            shutil.rmtree(stale, ignore_errors=True)
        else:
            os.rename(tmp, target_store)
        log(f"[svc] extracted in {time.time()-t0:.1f}s")

    # Live symlink (atomic swap when replacing a symlink)
    if target_store:
        try:
            if os.path.exists(live_link) and not os.path.islink(live_link):
                shutil.rmtree(live_link)
            _atomic_symlink(target_store, live_link)
        except Exception as e:
            log(f"ERROR: cannot replace {live_link}: {e}"); return False

    # Bins
    bins = cfg.get("artifact", {}).get("bins", [])
    for b in bins:
        if not _RE_BIN.match(str(b)):
            log(f"ERROR: invalid binary name {b!r} in {name}.toml")
            return False
        srcb = find_bin(live_link, b)
        if not srcb:
            log(f"ERROR: declared binary '{b}' not found in {live_link}")
            return False
        try: os.chmod(srcb, 0o755)
        except OSError: pass
        dst = os.path.join(BIN_DIR, b)
        try:
            _atomic_symlink(srcb, dst)
            log(f"[svc] link /usr/local/bin/{b} -> {srcb}")
        except Exception as e:
            log(f"ERROR: link {b} failed: {e}"); return False

    # Persist
    persist = cfg.get("persist", {})
    for src_rel, dst_path in persist.items():
        src_abs = os.path.join(BASE, src_rel)
        try: os.makedirs(src_abs, exist_ok=True)
        except Exception as e:
            log(f"ERROR: cannot mkdir {src_abs}: {e}"); return False
        dst_exp = os.path.expanduser(dst_path)
        try: os.makedirs(os.path.dirname(dst_exp), exist_ok=True)
        except Exception as e:
            log(f"ERROR: cannot mkdir parent of {dst_exp}: {e}"); return False
        if os.path.exists(dst_exp) and not os.path.islink(dst_exp):
            # [backup-unique] Second-resolution names could collide (two
            # rescues in the same second) and nest one copy inside the
            # other. Use a unique suffix so every rescue is independent.
            bak = f"{dst_exp}.bak-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
            n = 0
            while os.path.exists(bak):
                n += 1
                bak = f"{dst_exp}.bak-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}.{n}"
            try: shutil.move(dst_exp, bak)
            except Exception as e:
                log(f"ERROR: rescue {dst_exp} -> {bak} failed: {e}"); return False
            log(f"[svc] rescue {dst_exp} -> {bak}")
            # [bak-cleanup] Keep only the newest rescue copy per target so
            # repeated installs cannot grow the Drive footprint forever.
            try:
                olds = sorted(glob.glob(f"{dst_exp}.bak-*"), key=os.path.getmtime)
                for o in olds[:-1]:
                    if os.path.isdir(o) and not os.path.islink(o): shutil.rmtree(o, ignore_errors=True)
                    else: os.remove(o)
                    log(f"[svc] prune old rescue {o}")
            except Exception as e:
                log(f"[svc] warn: rescue cleanup failed for {dst_exp}: {e}")
        elif os.path.islink(dst_exp):
            try: os.remove(dst_exp)
            except OSError: pass
        try:
            os.symlink(src_abs, dst_exp)
            log(f"[svc] persist {dst_exp} -> {src_abs}")
        except Exception as e:
            log(f"ERROR: persist symlink {dst_exp} -> {src_abs} failed: {e}"); return False

    # Lifecycle hook: setup script runs for ALL app types (tool/cli/server)
    # [setup-hook-patch] generalized for all app types
    setup = os.path.join(BASE, "apps", f"{name}.sh")
    if not os.path.exists(setup):
        setup = os.path.join(BASE, "apps", "setup_" + name + ".sh")
    if os.path.exists(setup):
        log(f"[svc] setup {name}")
        t_setup = time.time()
        res = subprocess.run(["bash", setup])
        if res.returncode != 0:
            log(f"ERROR: lifecycle hook for {name} exited {res.returncode}")
            return False
        log(f"[svc] setup {name} ok ({time.time()-t_setup:.1f}s)")

    # Server-only auto-start + tailscale serve/funnel.
    # Only fires when (a) type=="server", (b) no custom setup script
    # already took responsibility for starting the daemon, (c) binary exists.
    has_setup = (os.path.exists(os.path.join(BASE, "apps", f"{name}.sh"))
                 or os.path.exists(os.path.join(BASE, "apps", "setup_" + name + ".sh")))
    if cfg.get("app", {}).get("type") == "server" and not has_setup:
        expose = cfg.get("expose", {})
        bin_path = os.path.join(live_link, "bin", name)
        if not os.path.exists(bin_path):
            bin_path = os.path.join(OPT, name, "bin", name)
        port = str(expose.get("port", ""))
        mode = expose.get("mode", "none")
        health = expose.get("health", "")
        if port and os.path.exists(bin_path):
            healthy = False
            if health:
                r = run_health(health)
                healthy = (r.returncode == 0)
            if not healthy:
                log(f"[svc] start {name} on :{port} mode {mode}")
                subprocess.Popen(
                    ["bash", "-c",
                     f"setsid nohup {shlex.quote(bin_path)} > /tmp/{shlex.quote(name)}.log 2>&1 < /dev/null &"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(2)
            if mode in ("tailnet", "funnel") and shutil.which("tailscale"):
                if mode == "funnel":
                    subprocess.run(["tailscale", "funnel", "--bg", port],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                else:
                    subprocess.run(["tailscale", "serve", "--bg", "--tcp", port,
                                    f"tcp://127.0.0.1:{port}"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True

