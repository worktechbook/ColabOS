# Doctor                                                                       #
# --------------------------------------------------------------------------- #
def _svc_shim_ok():
    svc_dst = os.path.join(BIN_DIR, "svc")
    svc_src = os.path.join(BASE, "engine", "svc")
    if not os.path.exists(svc_dst) or not os.access(svc_dst, os.X_OK): return False
    if os.path.islink(svc_dst): return False
    try:
        with open(svc_dst, "r", encoding="utf-8") as f:
            head = f.read(256)
    except Exception:
        return False
    return "python3" in head and svc_src in head

def _bin_ok(cfg, name, b):
    live_link = os.path.join(OPT, name)
    dst = os.path.join(BIN_DIR, b)
    expected = find_bin(live_link, b)
    if not expected: return False
    if not (os.path.islink(dst) and os.path.exists(dst)): return False
    return os.path.realpath(dst) == os.path.realpath(expected)

def _persist_ok(cfg, name):
    ok = True
    for src_rel, dst_path in cfg.get("persist", {}).items():
        src_abs = os.path.join(BASE, src_rel)
        dst_exp = os.path.expanduser(dst_path)
        # Compare canonical paths on BOTH sides: the declared Drive source
        # may itself be a symlink, and comparing a canonical target against
        # a non-canonical source produced a permanent doctor failure.
        if not (os.path.islink(dst_exp)
                and os.path.realpath(dst_exp) == os.path.realpath(src_abs)):
            ok = False
    return ok

def port_listening(port, host="127.0.0.1", timeout=1.0):
    """True if something accepts a TCP connection on host:port.

    Used by the bootstrap fast path as a cheap liveness probe. The full
    manifest health commands are far more expensive (they run every tool
    binary's --version and, for servers, reach the public URL),
    and they must not sit on the warm-boot hot path.
    """
    try:
        port = int(port)
    except (TypeError, ValueError):
        return False
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def _unix_socket_listening(sock_path, timeout=1.0):
    """True if a local Unix domain socket exists and accepts a connection."""
    if not sock_path or not os.path.exists(sock_path):
        return False
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(timeout)
        s.connect(sock_path)
        return True
    except OSError:
        return False
    finally:
        try:
            s.close()
        except OSError:
            pass


def detect_binary_version(cfg, name):
    """Ask the installed binary for its own version string.

    [version-drift] A native updater (`omp update`, `rustup update`, ...)
    replaces the binary inside the extracted store WITHOUT touching the
    manifest. The next auto-snapshot then packs the NEW binary under the
    OLD version string, producing a mislabeled artifact that every
    content-hash check happily accepts - the hash matches the tree, it
    just describes the wrong version.

    The version source must be unambiguous:
      - `[artifact].version_bin` names the binary that carries the app
        version (explicit, preferred);
      - otherwise a single-bin app uses that bin;
      - otherwise (a bundle of several binaries, e.g. devtools, whose app
        version `1.0.0` matches no individual tool) no version source
        exists and the check is skipped rather than guessing.

    Returns the version string the binary reports, or None when it cannot
    be determined.
    """
    bins = cfg.get("artifact", {}).get("bins", []) or []
    if not bins:
        return None
    want = cfg.get("artifact", {}).get("version_bin")
    if want:
        candidates = [want]
    elif len(bins) == 1:
        candidates = list(bins)
    else:
        # Multi-binary bundle: the app version describes the bundle, not
        # any one tool. Guessing here would produce false drift reports.
        return None
    live = os.path.join(OPT, name)
    if not os.path.exists(live):
        return None
    for b in candidates:
        path = find_bin(live, b)
        if not path:
            continue
        try:
            r = subprocess.run([path, "--version"], capture_output=True,
                               text=True, timeout=HEALTH_TIMEOUT)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode != 0:
            continue
        out = (r.stdout or "") + (r.stderr or "")
        for tok in out.replace("/", " ").replace(",", " ").split():
            cand = tok[1:] if tok.startswith(("v", "V")) and len(tok) > 1 and tok[1].isdigit() else tok
            if re.fullmatch(r"\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.\-]+)?", cand):
                return cand
    return None


def cmd_doctor(args):
    fix = args.fix
    # [doctor-lock] `doctor --fix` mutates the store, /usr/local/bin and the
    # persist symlinks. Taking the engine lock prevents it from racing a
    # concurrent bootstrap/install/snapshot.
    lock_fd = None
    if fix:
        lock_fd = acquire_lock()
    try:
      deep = getattr(args, "deep", True)
      unfixed = 0
      results = []
      repaired_apps = set()
      def _repair_install_once(n, force=False):
          if not force and n in repaired_apps:
              return True
          ok = install_app(n, quiet=False, force=force)
          if ok:
              repaired_apps.add(n)
          return ok
      def chk(label, cond, repair=None):
          nonlocal unfixed
          if cond:
              results.append(("OK", label)); return True
          results.append(("!!", label))
          if fix and repair is not None:
              try:
                  fixed = bool(repair())
                  if fixed:
                      results[-1] = ("FIX", label + " (fixed)")
                      return True
                  else:
                      results[-1] = ("ERR", label + " (repair failed)")
              except Exception as e:
                  results[-1] = ("ERR", f"fix failed for {label}: {e}")
          unfixed += 1
          return False

      chk(f"Drive {BASE}", os.path.isdir(BASE))
      zstd = shutil.which("zstd")
      chk("zstd", bool(zstd),
          repair=lambda: (not subprocess.run(["apt-get","update","-qq"]).returncode
                       and not subprocess.run(["apt-get","install","-y","-qq","zstd"]).returncode))

      chk(f"svc shim {os.path.join(BIN_DIR,'svc')} -> python3 engine/svc",
          _svc_shim_ok(), repair=_install_svc_shim)
      chk(f"profile {PROFILE_D}", os.path.exists(PROFILE_D),
          repair=write_profile)
      chk(f"motd {MOTD_D}", os.path.exists(MOTD_D),
          repair=write_motd)

      all_apps = get_apps()
      by_name = {n: c for n, c in all_apps}
      ordered_names = [n for lvl in install_levels(all_apps, strict=False) for n in lvl]
      for name in ordered_names:
          cfg = by_name[name]
          ver = cfg.get("app", {}).get("version", "?")
          src_tar = artifact_path(cfg, name)
          chk(f"{name} v{ver} tarball {os.path.basename(src_tar) if src_tar else 'MISSING'}",
              bool(src_tar) and os.path.exists(src_tar))
          declared = str(cfg.get("artifact", {}).get("sha256", "") or "").strip()
          if declared:
              chk(f"{name} v{ver} artifact digest declared",
                  len(declared) == 64 and all(c in "0123456789abcdefABCDEF" for c in declared))
          sdir = store_dir_for(cfg, name)
          chk(f"{name} v{ver} extracted at {sdir}",
              bool(sdir) and os.path.isdir(sdir),
              repair=lambda n=name: _repair_install_once(n, force=False))
          live = os.path.join(OPT, name)
          detected = detect_binary_version(cfg, name)
          has_drift = bool(detected and ver != "?" and detected != ver)
          if has_drift:
              def _repair_drift(n=name, want=detected):
                  # Snapshot the LIVE updated binary directly under its reported version
                  # (never re-extract the old tarball first, which would destroy the update).
                  return _snapshot_with_version(n, want)
              if chk(f"{name} version drift: manifest {ver} but binary reports {detected}",
                     False, repair=_repair_drift):
                  # Reload manifest/paths after snapshot reconciled the live store.
                  cfg_p = os.path.join(BASE, "apps", f"{name}.toml")
                  if os.path.exists(cfg_p):
                      cfg = load_toml(cfg_p)
                      ver = cfg.get("app", {}).get("version", ver)
                      sdir = store_dir_for(cfg, name)
                  has_drift = False
          if deep and sdir and os.path.isdir(sdir):
              expected = os.path.basename(sdir).rsplit("-", 1)[-1]
              try:
                  actual = sha16_of_dir(sdir, hash_excludes(cfg))
              except RuntimeError as e:
                  actual = f"ERROR({e})"
              # Never force-reinstall the old tarball while version drift is unresolved.
              hash_repair = None if has_drift else (lambda n=name: _repair_install_once(n, force=True))
              chk(f"{name} v{ver} content hash {actual} (expected {expected})",
                  actual == expected,
                  repair=hash_repair)
          link_ok = bool(sdir) and os.path.islink(live) and os.path.realpath(live) == os.path.realpath(sdir)
          chk(f"{name} v{ver} symlink {live}", link_ok,
              repair=lambda n=name: _repair_install_once(n, force=False))
          for b in cfg.get("artifact", {}).get("bins", []):
              chk(f"{name}: bin {os.path.join(BIN_DIR,b)}", _bin_ok(cfg, name, b),
                  repair=lambda n=name: _repair_install_once(n, force=False))
          for src_rel, dst_path in cfg.get("persist", {}).items():
              src_abs = os.path.join(BASE, src_rel)
              dst_exp = os.path.expanduser(dst_path)
              chk(f"persist {dst_exp} -> {src_rel}",
                  os.path.islink(dst_exp) and os.path.exists(dst_exp)
                  and os.path.realpath(dst_exp) == os.path.realpath(src_abs),
                  repair=lambda n=name: _repair_install_once(n, force=False))
        # [doctor-fast-probe] On the shallow (bootstrap fast-path) run,
        # the full manifest health commands are replaced by a cheap TCP
        # connect to the exposed port. The full commands run every tool
        # binary's --version and, for servers, reach the public URL
        # URL - together several seconds, which does not belong on the
        # warm-boot hot path. A server whose port is closed is still
        # detected here, which is what the fast path needs to decide
        # whether to reinstall.
        #
        # Tool apps (no exposed port) get no runtime probe at all on the
        # shallow path: their binaries are already verified structurally
        # by the `bins[]` symlink checks above, and invoking 20 binaries
        # just to print their versions is pure warm-boot cost.
          app_health = cfg.get("health", {}).get("command")
          expose_health = cfg.get("expose", {}).get("health")
          expose_port = cfg.get("expose", {}).get("port")
          if not deep:
              if cfg.get("app", {}).get("type") == "server" and expose_port:
                  fast_ok = port_listening(expose_port)
                  if cfg.get("expose", {}).get("mode") == "tailnet":
                      fast_ok = fast_ok and _unix_socket_listening("/var/run/tailscale/tailscaled.sock")
                  chk(f"{name}: runtime health (port {expose_port})", fast_ok)
          else:
              if app_health:
                  r = run_health(app_health)
                  chk(f"{name}: runtime health", r.returncode == 0,
                      repair=lambda n=name: _repair_install_once(n, force=False))
              if expose_health:
                  r = run_health(expose_health)
                  chk(f"  health: {expose_health}", r.returncode == 0,
                      repair=lambda n=name: _repair_install_once(n, force=False))

      if fix:
          write_profile()

      print("== ColabOS Doctor ==")
      for st, label in results:
          tag = {"OK":"[OK]","!!":"[!!]","FIX":"[fix]","ERR":"[ERR]"}[st]
          print(f"  {tag} {label}")
      globals()["LAST_DOCTOR_RESULTS"] = list(results)
      ok_all = (unfixed == 0)
      if ok_all:
          if fix and any(st == "FIX" for st, _ in results):
              print("ALL CHECKS PASSED (Healed)")
          else:
              print("ALL CHECKS PASSED (Healthy)")
      else:
          print("ISSUES FOUND — run `svc doctor --fix` to auto-heal.")
      return ok_all
    finally:
      if lock_fd is not None:
          try: fcntl.flock(lock_fd, fcntl.LOCK_UN)
          except Exception: pass
          lock_fd.close()

