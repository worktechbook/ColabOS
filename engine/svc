def cmd_doc_table(args=None):
    """Output Markdown (or JSON) table of all apps from live manifests and artifacts."""
    as_json = getattr(args, "json", False) if args else False
    apps = get_apps()
    rows = []
    for name, cfg in apps:
        app_sec = cfg.get("app", {})
        art_sec = cfg.get("artifact", {})
        ver = app_sec.get("version", "?")
        typ = app_sec.get("type", "?")
        art_file = art_sec.get("file", "-")
        art_sha = art_sec.get("sha256", "-")
        bins = ", ".join(art_sec.get("bins", [])) or "-"
        persists = ", ".join(cfg.get("persist", {}).values()) or "-"

        art_p = artifact_path(cfg, name)
        size_str = "-"
        sz_bytes = 0
        if art_p and os.path.exists(art_p):
            sz_bytes = os.path.getsize(art_p)
            size_str = _human_size(sz_bytes)

        sdir = store_dir_for(cfg, name)
        h = (sdir or "").split("-")[-1] if sdir else "-"
        rows.append({
            "name": name,
            "version": ver,
            "type": typ,
            "artifact": art_file,
            "size": size_str,
            "size_bytes": sz_bytes,
            "hash": h,
            "sha256": art_sha,
            "bins": bins,
            "persist": persists,
        })

    if as_json:
        out = json.dumps(rows, indent=2)
        print(out)
        return out

    headers = ["App", "Version", "Type", "Artifact File", "Size", "Content Hash", "Tarball Digest (SHA-256)", "Binaries", "Persist Mounts"]
    lines = []
    lines.append("| " + " | ".join(headers) + " |")
    lines.append("| " + " | ".join([":---"] * len(headers)) + " |")
    for r in rows:
        sha_display = f"{r['sha256'][:16]}..." if len(r['sha256']) == 64 else f"{r['sha256']}"
        lines.append(f"| {r['name']} | {r['version']} | {r['type']} | {r['artifact']} | {r['size']} | {r['hash']} | {sha_display} | {r['bins']} | {r['persist']} |")
    out = "\n".join(lines)
    print(out)
    return out

def cmd_list(args):
    if getattr(args, "markdown", False):
        return cmd_doc_table(args)
    print(f"ColabOS v{VERSION} Apps (Drive: {BASE})")
    print("-"*100)
    print(f"{'NAME':<18} | {'TYPE':<8} | {'VERSION':<8} | {'MODE':<9} | {'HASH':<16} | {'STATUS':<10}")
    print("-"*100)
    for name, cfg in get_apps():
        ver  = cfg.get("app",{}).get("version","?")
        typ  = cfg.get("app",{}).get("type","?")
        mode = cfg.get("expose",{}).get("mode","-")
        sdir = store_dir_for(cfg, name)
        h = (sdir or "").split("-")[-1] if sdir else "-"
        status = "installed" if sdir and os.path.isdir(sdir) else "not installed"
        print(f"{name:<18} | {typ:<8} | {ver:<8} | {mode:<9} | {h:<16} | {status:<10}")
    print("-"*100)

def _human_size(n):
    for u in ("B","KiB","MiB","GiB"):
        if n < 1024: return f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} TiB"

def _persist_size(src_abs, max_entries=2000):
    """Best-effort size of a persisted tree, bounded in time and entries.

    `svc status` must stay fast. A full walk over Drive FUSE of the OMP
    state (plugins, Chromium, npm cache) took over ten minutes. Walk at
    most `max_entries` files and report whether the result is partial.
    """
    if not os.path.isdir(src_abs):
        return "missing"
    total = 0
    count = 0
    truncated = False
    for dp, dns, fns in os.walk(src_abs):
        for fn in fns:
            if count >= max_entries:
                truncated = True
                break
            try:
                total += os.path.getsize(os.path.join(dp, fn))
                count += 1
            except OSError:
                pass
        if truncated:
            break
    size = _human_size(total)
    return f">= {size} (partial)" if truncated else size

def cmd_status(args):
    if getattr(args, "markdown", False):
        return cmd_doc_table(args)
    target = args.name
    found = False
    for name, cfg in get_apps():
        if target and name != target: continue
        found = True
        print(f"--- {name} ---")
        print(f"  type      : {cfg.get('app',{}).get('type','?')}")
        print(f"  version   : {cfg.get('app',{}).get('version','?')}")
        tar = artifact_path(cfg, name)
        if tar and os.path.exists(tar):
            print(f"  artifact  : {os.path.basename(tar)}  ({os.path.getsize(tar)/(1024*1024):.1f} MiB)")
        sdir = store_dir_for(cfg, name)
        print(f"  installed : {'yes' if sdir and os.path.isdir(sdir) else 'no'}")
        live = os.path.join(OPT, name)
        if os.path.islink(live):
            print(f"  live link : {live} -> {os.readlink(live)}")
        print(f"  bins      : {', '.join(cfg.get('artifact',{}).get('bins',[]))}")
        if sdir:
            expected = os.path.basename(sdir).rsplit("-", 1)[-1]
            try:
                actual = sha16_of_dir(sdir, hash_excludes(cfg)) if os.path.isdir(sdir) else "-"
            except RuntimeError as e:
                actual = f"ERROR({e})"
            print(f"  hash      : {actual} (expected {expected}) {'OK' if actual==expected else 'MISMATCH'}")
        expose = cfg.get("expose",{})
        if expose:
            mode = expose.get("mode","-"); port = expose.get("port","")
            h = expose.get("health","")
            ok = False
            if h:
                # [probe-timeout] Bounded, like every other manifest probe.
                r = run_health(h)
                ok = (r.returncode == 0)
            print(f"  expose    : {mode} :{port} health={'ok' if ok else 'down'}")
        for src_rel, dst_path in cfg.get("persist",{}).items():
            src_abs = os.path.join(BASE, src_rel); dst_exp = os.path.expanduser(dst_path)
            # [status-size] The persisted tree can hold hundreds of MB of
            # npm cache, OMP plugins and a Chromium download. Walking it
            # file-by-file over Drive FUSE made `svc status` take minutes
            # (observed: >600 s). Report the size only when it is cheap to
            # obtain, and never block the command.
            print(f"  persist   : {dst_exp} <- {src_rel}  ({_persist_size(src_abs)})")
        app_h = cfg.get("health", {}).get("command", "")
        if app_h:
            r = run_health(app_h)
            print(f"  health    : {'ok' if r.returncode == 0 else 'down'}")
        print()
    if target and not found:
        print(f"ERROR: unknown app '{target}'")
        sys.exit(1)

def _log_paths_for(name, cfg):
    """Return a list of candidate log files for a service."""
    cands = []
    # Convention: /tmp/<name>.log for generic servers
    cands.append(f"/tmp/{name}.log")
    # Known per-service conventions
    if name == "tailscale-ssh":
        cands.append("/var/log/tailscaled.log")
        cands.append(os.path.join(BASE, "home/tailscale-ssh/tailscale/tailscaled.log"))
    # [app] log key if declared (safe token substitution, no str.format)
    log_key = cfg.get("app",{}).get("log","")
    if log_key:
        cands.append(str(log_key).replace("{base}", BASE).replace("{opt}", OPT).replace("{name}", name))
    return [p for p in cands if os.path.exists(p)]

def cmd_logs(args):
    name = args.name
    cfg_path = os.path.join(BASE, "apps", f"{name}.toml")
    if not os.path.exists(cfg_path):
        print(f"ERROR {cfg_path}"); sys.exit(1)
    cfg = load_toml(cfg_path)
    logs = _log_paths_for(name, cfg)
    if not logs:
        print(f"[logs] no log files found for {name}.")
        # Generic servers log to /tmp/<name>.log; tailscaled logs to its persist dir.
        print(f"       expected locations: /tmp/{name}.log, plus any [app].log path in TOML.")
        sys.exit(0)
    follow = [] if args.no_follow else ["-f"]
    n = ["-n", str(args.lines)]
    cmd = ["tail"] + n + follow + ["--"] + logs
    print(f"[logs] tailing {', '.join(logs)} (Ctrl-C to stop)")
    os.execvp("tail", cmd)

