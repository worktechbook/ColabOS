import os, sys, glob, shutil, subprocess, time, argparse, hashlib, fcntl, json, re, socket, shlex, tempfile
from concurrent.futures import ThreadPoolExecutor, as_completed

VERSION         = "1.1.8"
SCHEMA_VERSION  = 1                       # engine understands TOML schema <= this
HEALTH_TIMEOUT  = 20                      # seconds; bounded so a hung probe cannot stall a boot
ZSTD_COMPRESS   = "-6"                    # tuned: -3 was 30 MiB larger with no cold-boot win (Drive FUSE is the bottleneck, not CPU)
ZSTD_DECOMPRESS = "-T0"                   # multi-threaded decompress always

BASE            = os.environ.get("COLABOS_BASE", "/content/drive/MyDrive/ColabOS")
OPT             = "/opt/colabos"
STORE_OPT       = "/opt/colabos/store"
BIN_DIR         = "/usr/local/bin"
PROFILE_D       = "/etc/profile.d/colabos.sh"
MOTD_D          = "/etc/profile.d/colabos-motd.sh"
RUN_DIR         = "/run/colabos"
LOCK_FILE       = os.path.join(RUN_DIR, "colabos.lock")
WRAP_SNAPSHOT_LOCK = os.path.join(RUN_DIR, "colabos_snapshot.lock")

_RE_NAME    = re.compile(r"^[A-Za-z0-9._-]+$")
_RE_ENV_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
_RE_BIN     = re.compile(r"^[A-Za-z0-9._+-]+$")
_RE_SEMVER  = r"\d+(?:\.\d+)*(?:[-+][0-9A-Za-z.\-]+)?"

def _validate_basename(val, label):
    s = str(val or "")
    if not s or "/" in s or "\\" in s or s in (".", "..") or not _RE_NAME.match(s):
        raise ValueError(f"invalid {label}: {val!r}")
    return s

def _atomic_symlink(src_target, dst_link):
    parent = os.path.dirname(dst_link) or "."
    os.makedirs(parent, exist_ok=True)
    tmp_link = os.path.join(parent, f".{os.path.basename(dst_link)}.tmp.{os.getpid()}.{time.time_ns()}")
    try:
        os.symlink(src_target, tmp_link)
        os.replace(tmp_link, dst_link)
    except Exception:
        try:
            if os.path.lexists(tmp_link):
                os.unlink(tmp_link)
        except OSError:
            pass
        raise

# "install" is deliberately NOT an update verb: `npm install <pkg>` and
# `cargo install <crate>` are ordinary package installs, not self-updates
# of the bundled tool, and must not trigger a full app snapshot.
UPDATE_VERBS = frozenset({"update", "upgrade", "self-update"})
NOOP_FLAGS   = frozenset({"-h", "--help", "-v", "--version", "--dry-run", "--dryrun",
                          "--dry", "--report", "--check", "--list", "-l"})

# --------------------------------------------------------------------------- #
# TOML                                                                         #
# --------------------------------------------------------------------------- #
def _strip_inline_comment(line):
    """Strip a # comment that starts outside any string (respects backslash escapes)."""
    in_s = None
    esc = False
    for i, ch in enumerate(line):
        if in_s:
            if esc:
                esc = False
            elif ch == "\\" and in_s == '"':
                esc = True
            elif ch == in_s:
                in_s = None
        elif ch in ('"', "'"):
            in_s = ch
        elif ch == '#':
            return line[:i].rstrip()
    return line


def _parse_scalar(v):
    if len(v) >= 2 and ((v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'"))):
        try:
            # Double-quoted TOML strings share escapes with JSON for our charset.
            return json.loads(v) if v.startswith('"') else v[1:-1]
        except Exception:
            return v[1:-1]
    if v.lower() == "true":
        return True
    if v.lower() == "false":
        return False
    try:
        return int(v)
    except ValueError:
        pass
    try:
        return float(v)
    except ValueError:
        pass
    return v


def _unquote_key(k):
    k = k.strip()
    if len(k) >= 2 and ((k.startswith('"') and k.endswith('"')) or (k.startswith("'") and k.endswith("'"))):
        try:
            return json.loads(k) if k.startswith('"') else k[1:-1]
        except Exception:
            return k[1:-1]
    return k


def load_toml(path):
    try:
        import tomllib
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (ImportError, ModuleNotFoundError):
        data, cur = {}, None
        pending_key = None
        pending_parts = []
        with open(path, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                line = _strip_inline_comment(raw.strip())
                if not line:
                    continue
                if pending_key is not None:
                    pending_parts.append(line)
                    if line.rstrip().endswith("]"):
                        inner = " ".join(pending_parts)
                        data[cur][pending_key] = [
                            _parse_scalar(x.strip()) for x in inner[1:-1].split(",") if x.strip()
                        ]
                        pending_key = None
                        pending_parts = []
                    continue
                if line.startswith("[") and line.endswith("]"):
                    cur = line[1:-1].strip(); data[cur] = {}
                elif "=" in line and cur:
                    k, v = line.split("=", 1)
                    k, v = _unquote_key(k), v.strip()
                    if v.startswith("[") and not v.rstrip().endswith("]"):
                        pending_key = k
                        pending_parts = [v]
                        continue
                    if v.startswith("[") and v.endswith("]"):
                        data[cur][k] = [
                            _parse_scalar(x.strip()) for x in v[1:-1].split(",") if x.strip()
                        ]
                    else:
                        data[cur][k] = _parse_scalar(v)
        return data


def _toml_key(k):
    k = str(k)
    if re.match(r'^[A-Za-z0-9_-]+$', k):
        return k
    return json.dumps(k)


def _toml_val(v):
    if isinstance(v, bool):
        return str(v).lower()
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(_toml_val(x) for x in v) + "]"
    return json.dumps(str(v))


def atomic_write(path, content, mode=0o644):
    """Write `content` to `path` atomically.

    A Drive/FUSE interruption must never leave a truncated live manifest,
    profile or MOTD behind. The temp file is created in the SAME directory
    (so os.replace stays on one filesystem) and renamed into place.
    """
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".colabos-tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            try:
                os.fsync(f.fileno())
            except OSError:
                pass
        try:
            os.chmod(tmp, mode)
        except OSError:
            pass
        os.replace(tmp, path)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        raise

def save_toml(path, cfg):
    out = []
    for sec, vals in cfg.items():
        if not isinstance(vals, dict):
            raise TypeError(f"TOML section {sec!r} must be a dict")
        out.append(f"[{sec}]\n")
        for k, v in vals.items():
            if isinstance(v, dict):
                raise TypeError(f"nested TOML table [{sec}.{k}] is not supported by save_toml")
            out.append(f"{_toml_key(k)} = {_toml_val(v)}\n")
        out.append("\n")
    atomic_write(path, "".join(out), mode=0o600)

def check_schema(cfg, name):
    """Refuse to run if the TOML asks for a schema_version newer than we know."""
    sv = cfg.get("app", {}).get("schema_version", 1)
    try:
        sv = int(sv)
    except Exception:
        sv = 1
    if sv > SCHEMA_VERSION:
        print(f"ERROR: {name}.toml requires schema_version {sv} but this engine is v{VERSION} (schema {SCHEMA_VERSION}).")
        print(f"       Upgrade engine/svc before booting; refusing to continue.")
        return False
    return True

# --------------------------------------------------------------------------- #
# Hashing                                                                      #
# --------------------------------------------------------------------------- #
def sha16_of_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()[:16]

def sha256_of_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()

def run_health(cmd, timeout=None):
    """Run a manifest health probe with a bounded timeout.

    Health commands come from TOML and are executed through a shell, so a
    hung endpoint (or a probe that blocks on stdin) would otherwise stall
    doctor and bootstrap forever. Returns the CompletedProcess.
    """
    try:
        return subprocess.run(cmd, shell=True, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              timeout=(timeout or HEALTH_TIMEOUT))
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 124, b"", b"health probe timed out")

def verify_artifact_digest(cfg, name, path):
    """Verify [artifact].sha256 against the tarball. Fails closed.

    The 16-hex in the artifact FILENAME is a hash of the extracted tree
    (with hash_exclude applied), not of the tarball itself, so it cannot
    detect a corrupted or tampered download. An explicit `sha256` field in
    the manifest is the tarball digest and is checked here.

    Returns (ok, message). When no digest is declared, ok=True and the
    message says so — the check is opt-in per app, not silently skipped.
    """
    want = str(cfg.get("artifact", {}).get("sha256", "") or "").strip().lower()
    if not want:
        return True, "no digest declared (skipped)"
    if len(want) != 64 or any(c not in "0123456789abcdef" for c in want):
        return False, f"malformed sha256 in manifest: {want[:16]}..."
    got = sha256_of_file(path)
    if got.lower() != want:
        return False, f"DIGEST MISMATCH expected={want[:16]}... got={got[:16]}..."
    return True, f"digest ok ({got[:16]}...)"

def hash_excludes(cfg):
    """Patterns excluded from the content hash (runtime-mutable dirs).

    Apps whose runtime writes into their own install (e.g. a Next.js
    `.next` route cache) would otherwise never match their artifact hash.
    The exclusion applies to hashing only - snapshots still archive
    everything, so a fresh extract stays runnable.
    """
    pats = cfg.get("app", {}).get("hash_exclude", [])
    if isinstance(pats, str):
        pats = [pats]
    return [str(p).strip() for p in pats if str(p).strip()]

def sha16_of_dir(path, excludes=None):
    """Hash a directory tree deterministically.

    tar's exit status is checked: a partial stream must never be hashed
    and compared as if it were the authoritative content hash.
    """
    cmd = ["tar", "-cf", "-", "-C", path, "--sort=name"]
    for pat in (excludes or []):
        cmd += ["--exclude", pat]
    cmd.append(".")
    with tempfile.TemporaryFile() as err_fh:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err_fh)
        h = hashlib.sha256()
        for chunk in iter(lambda: p.stdout.read(1 << 20), b""):
            h.update(chunk)
        p.stdout.close()
        rc = p.wait()
        err_fh.seek(0)
        err = err_fh.read().decode("utf-8", "replace")
    if rc != 0:
        raise RuntimeError(f"tar failed hashing {path}: {err.strip()}")
    return h.hexdigest()[:16]

