def cmd_snapshot(args):
    fd = acquire_lock()
    try:
        if not _cmd_snapshot_locked(args):
            sys.exit(1)
    finally:
        try: fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError: pass
        fd.close()

def _snapshot_with_version(name, version):
    """Snapshot an app under an explicit version, without taking the lock."""
    args = argparse.Namespace(name=name, version=version)
    return bool(_cmd_snapshot_locked(args))


def _artifact_files(name):
    """Return this app's artifact filenames, most recent first (supports prerelease semver)."""
    apps_dir = os.path.join(BASE, "apps")
    out = []
    pat = re.compile(
        rf"^{re.escape(name)}-{_RE_SEMVER}-[0-9a-f]{{16}}\.tar\.zst$")
    for x in os.listdir(apps_dir):
        if pat.match(x):
            out.append(x)
    return sorted(out,
                  key=lambda x: os.path.getmtime(os.path.join(apps_dir, x)),
                  reverse=True)

def _cmd_snapshot_locked(args):
    name = args.name
    try:
        _validate_basename(name, "app name")
    except ValueError as e:
        print(f"ERROR: {e}"); return False
    cfg_path = os.path.join(BASE, "apps", f"{name}.toml")
    if not os.path.exists(cfg_path):
        print(f"ERROR {cfg_path}"); return False
    cfg = load_toml(cfg_path)
    live = os.path.join(OPT, name)
    if not os.path.exists(live):
        print(f"ERROR live {live}"); return False
    real = os.path.realpath(live)
    ver = args.version if args.version else cfg.get("app", {}).get("version", "1.0.0")
    # [version-drift] Prefer the version the installed binary actually
    # reports over the stale manifest version. A native updater replaces
    # the binary in place; without this the new binary would be packed
    # under the OLD version string, producing a mislabeled artifact.
    if not args.version:
        detected = detect_binary_version(cfg, name)
        if detected and detected != ver:
            print(f"[snapshot] version drift: manifest says {ver}, binary reports {detected}")
            ver = detected
    h = sha16_of_dir(real, hash_excludes(cfg))
    fname = f"{name}-{ver}-{h}.tar.zst"
    out = os.path.join(BASE, "apps", fname)
    if os.path.exists(out) and cfg.get("artifact", {}).get("file") == fname:
        print(f"[snapshot] already up to date: {fname}")
        return _reconcile_after_snapshot(name, cfg, fname, ver, out)
    print(f"[snapshot] {name} -> {fname}")
    t0 = time.time()
    # [atomic-write] Pack into a temp file on Drive and rename it into
    # place, so an interrupted snapshot never leaves a corrupt artifact
    # under the expected name.
    tmp_out = out + ".tmp"
    try:
        os.unlink(tmp_out)
    except OSError:
        pass
    res = subprocess.run(["tar", "-I", f"zstd {ZSTD_COMPRESS} -T0", "-cf", tmp_out, "-C", real,
                          "--sort=name", "."])
    if res.returncode != 0:
        print("ERROR tar")
        try: os.unlink(tmp_out)
        except OSError: pass
        return False
    os.replace(tmp_out, out)
    print(f"[snapshot] packed in {time.time()-t0:.1f}s ({os.path.getsize(out)/(1024*1024):.1f} MiB)")
    digest = sha256_of_file(out)
    return _reconcile_after_snapshot(name, cfg, fname, ver, out, digest)

def _reconcile_after_snapshot(name, cfg, fname, ver, out, digest=None):
    """Make the live installation agree with the new artifact.

    [snapshot-reconcile] A snapshot used to update only the manifest,
    leaving /opt/colabos/<name> pointing at the OLD store directory and
    the new store path missing. Doctor then reported the app as not
    extracted until a separate bootstrap ran. Now the store directory is
    renamed to the new content-addressed stem, the live symlink and the
    binary links are repointed, and the lifecycle hook is re-run.
    """
    cfg_path = os.path.join(BASE, "apps", f"{name}.toml")
    live = os.path.join(OPT, name)
    real = os.path.realpath(live) if os.path.exists(live) else None
    new_store = os.path.join(STORE_OPT, fname[:-len(".tar.zst")])
    old_store = real
    old_artifact = cfg.get("artifact", {}).get("file", "")

    # 1. Move the live tree to its new content-addressed name.
    if old_store and os.path.isdir(old_store):
        if os.path.abspath(old_store) != os.path.abspath(new_store):
            if os.path.exists(new_store):
                shutil.rmtree(new_store, ignore_errors=True)
            os.rename(old_store, new_store)
            print(f"[snapshot] store {os.path.basename(old_store)} -> {os.path.basename(new_store)}")
            old_store = new_store
        else:
            old_store = new_store
    # 2. Repoint the live symlink atomically.
    if os.path.exists(live) and not os.path.islink(live):
        shutil.rmtree(live, ignore_errors=True)
    if os.path.isdir(new_store):
        _atomic_symlink(new_store, live)

    # 3. Rewrite the manifest (atomically) with the new artifact.
    cfg.setdefault("app", {})["version"] = ver
    cfg["app"]["schema_version"] = cfg["app"].get("schema_version", SCHEMA_VERSION)
    cfg.setdefault("artifact", {})["file"] = fname
    if digest is None:
        digest = sha256_of_file(out)
    cfg["artifact"]["sha256"] = digest
    save_toml(cfg_path, cfg)
    print(f"[snapshot] updated {cfg_path} (sha256={digest[:16]}...)")

    # 4. Relink binaries strictly and re-run the lifecycle hook.
    cfg = load_toml(cfg_path)
    bins = cfg.get("artifact", {}).get("bins", [])
    linked = 0
    for b in bins:
        srcb = find_bin(live, b)
        if not srcb:
            print(f"[snapshot] ERROR: declared binary '{b}' not found in {live}")
            return False
        dst = os.path.join(BIN_DIR, b)
        _atomic_symlink(srcb, dst)
        linked += 1
    print(f"[snapshot] relinked {linked} binary link(s)")

    setup = os.path.join(BASE, "apps", f"{name}.sh")
    if not os.path.exists(setup):
        setup = os.path.join(BASE, "apps", "setup_" + name + ".sh")
    if os.path.exists(setup):
        r = subprocess.run(["bash", setup])
        if r.returncode != 0:
            print(f"ERROR: lifecycle hook for {name} exited {r.returncode} after snapshot")
            return False
        print(f"[snapshot] lifecycle hook ok")

    # 5. Prune old artifacts: keep exactly the current one plus one prior.
    # [prune-exact] Retention is exact and app-scoped.
    files = _artifact_files(name)
    keep = {fname}
    for f in files:
        if len(keep) >= 2:
            break
        if f != fname:
            keep.add(f)
    for f in files:
        if f in keep:
            continue
        try:
            os.remove(os.path.join(BASE, "apps", f))
            print(f"[prune] {f}")
        except OSError:
            pass
    # Remove any store directory for THIS app only (anchored version+hash regex).
    keep_stems = {f[:-len(".tar.zst")] for f in keep}
    store_pat = re.compile(rf"^{re.escape(name)}-{_RE_SEMVER}-[0-9a-f]{{16}}$")
    if os.path.isdir(STORE_OPT):
        for entry in os.listdir(STORE_OPT):
            d = os.path.join(STORE_OPT, entry)
            if store_pat.match(entry) and entry not in keep_stems and os.path.isdir(d):
                shutil.rmtree(d, ignore_errors=True)
                print(f"[prune] store {entry}")
    return True

# --------------------------------------------------------------------------- #
# Bootstrap (fast-path)                                                        #
# --------------------------------------------------------------------------- #
def cmd_bootstrap(args):
    fd = acquire_lock()
    try:
        os.makedirs(OPT, exist_ok=True)
        os.makedirs(STORE_OPT, exist_ok=True)
        _install_svc_shim()
        # Fast path: if every doctor check already passes, skip reinstall/relink
        # work. This is the common warm-boot case.
        #
        # The fast path uses a SHALLOW doctor (deep=False): the content-hash
        # comparison hashes every store tree and would cost ~25 s, blowing
        # the warm-boot budget (<0.4 s). An explicit `svc doctor` still runs
        # the deep check.
        t0 = time.time()
        if cmd_doctor(argparse.Namespace(fix=False, deep=False)):
            # Ensure profile + motd are up to date even on fast path (cheap)
            write_profile()
            dt = time.time() - t0
            print(f"[svc] boot complete in {dt:.2f}s (warm, fast-path)")
            return
        print("[svc] doctor reported issues; running full bootstrap...")
        apps = get_apps()
        # [depends-strict] A missing dependency or a cycle is a hard
        # error: silently downgrading the order would start a dependent
        # app before (or without) its dependency.
        try:
            levels = install_levels(apps, strict=True)
        except ValueError as e:
            print(f"[svc] FATAL: invalid dependency graph: {e}")
            sys.exit(1)
        total = sum(len(l) for l in levels)
        print(f"[svc] bootstrap ColabOS v{VERSION} ({total} app(s) in {len(levels)} dependency level(s)) on {BASE}")
        # Install one dependency level at a time. An app only starts once
        # every app it depends_on has installed AND its lifecycle hook has
        # returned successfully. Previously every app was submitted to one
        # shared thread pool, which discarded the topological order.
        for li, level in enumerate(levels):
            # install_levels() returns a list of LISTS OF NAMES.
            names = list(level)
            if li:
                print(f"[svc] dependency level {li}: {', '.join(names)}")
            with ThreadPoolExecutor(max_workers=max(1, min(3, len(names)))) as ex:
                futs = {ex.submit(install_app, n, quiet=False): n for n in names}
                failed = []
                for fut in as_completed(futs):
                    n = futs[fut]
                    try:
                        if not fut.result():
                            failed.append(n)
                    except Exception as e:
                        print(f"[svc] FATAL: exception installing {n}: {e}")
                        failed.append(n)
                if failed:
                    for n in failed:
                        print(f"[svc] FATAL: install failed for {n}")
                    sys.exit(1)
        write_profile()
        dt = time.time() - t0
        print(f"[svc] boot complete in {dt:.2f}s ({'warm' if dt < 2 else 'cold'})")
        print("[svc] doctor: run 'svc doctor' to verify everything")
    finally:
        try: fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError: pass
        fd.close()

