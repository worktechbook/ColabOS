def main():
    p = argparse.ArgumentParser(description=f"ColabOS svc v{VERSION}")
    p.add_argument("--version", action="version", version=f"ColabOS svc v{VERSION}")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("bootstrap")
    d = sub.add_parser("doctor"); d.add_argument("--fix", action="store_true")
    l = sub.add_parser("list")
    l.add_argument("-m", "--markdown", action="store_true", help="output as markdown table")
    s = sub.add_parser("install"); s.add_argument("name")
    s.add_argument("--force", action="store_true",
                   help="re-extract the artifact even if the store directory exists")
    s = sub.add_parser("snapshot"); s.add_argument("name"); s.add_argument("--version")
    s = sub.add_parser("status"); s.add_argument("name", nargs="?")
    s.add_argument("-m", "--markdown", action="store_true", help="output as markdown table")
    dt = sub.add_parser("doc-table", help="generate markdown state table of all apps")
    dt.add_argument("--json", action="store_true", help="output as JSON instead of Markdown")
    s = sub.add_parser("logs"); s.add_argument("name")
    s.add_argument("-n","--lines", type=int, default=40, help="lines to show (default 40)")
    s.add_argument("--no-follow", action="store_true", help="print and exit (don't tail -f)")
    args = p.parse_args()

    if args.cmd == "bootstrap": cmd_bootstrap(args)
    elif args.cmd == "doctor":  sys.exit(0 if cmd_doctor(args) else 1)
    elif args.cmd == "list":    cmd_list(args)
    elif args.cmd == "install": cmd_install(args)
    elif args.cmd == "snapshot":cmd_snapshot(args)
    elif args.cmd == "status":  cmd_status(args)
    elif args.cmd == "doc-table": cmd_doc_table(args)
