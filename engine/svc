# Lock                                                                         #
# --------------------------------------------------------------------------- #
def acquire_lock():
    lock_dir = os.path.dirname(LOCK_FILE) or "/tmp"
    try:
        os.makedirs(lock_dir, mode=0o700, exist_ok=True)
    except OSError:
        pass
    raw_fd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR, 0o600)
    fd = os.fdopen(raw_fd, "r+")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("[svc] another svc is running; waiting for lock...", flush=True)
        fcntl.flock(fd, fcntl.LOCK_EX)
    return fd

