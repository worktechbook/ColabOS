def get_apps():
    apps = []
    adir = os.path.join(BASE, "apps")
    if not os.path.isdir(adir):
        return apps
    for f in sorted(os.listdir(adir)):
        if f.endswith(".toml"):
            name = f[:-5]
            cfg  = load_toml(os.path.join(adir, f))
            if not check_schema(cfg, name):
                sys.exit(2)
            apps.append((name, cfg))
    return apps


def install_order(apps):
    """Topologically sort apps by `[app].depends_on` (list of app names).

    Apps whose dependencies are missing or not present are treated as
    independent and never block the boot. Cycles fall back to the original
    sorted order so a bad manifest can't deadlock startup.
    """
    by_name = {name: cfg for name, cfg in apps}
    indeg = {name: 0 for name, _ in apps}
    edges = {name: [] for name, _ in apps}
    for name, cfg in apps:
        for dep in cfg.get("app", {}).get("depends_on", []) or []:
            if dep in by_name:
                edges[dep].append(name)
                indeg[name] += 1
    from collections import deque
    q = deque(sorted(n for n, d in indeg.items() if d == 0))
    out = []
    seen = set()
    while q:
        n = q.popleft()
        if n in seen:
            continue
        seen.add(n)
        out.append((n, by_name[n]))
        for m in sorted(edges[n]):
            indeg[m] -= 1
            if indeg[m] <= 0 and m not in seen:
                q.append(m)
    if len(out) != len(apps):
        # Cycle or missing deps: keep original order, never deadlock.
        return list(apps)
    return out

def install_levels(apps, strict=False):
    """Group apps into dependency LEVELS.

    Level 0 = apps with no satisfied dependencies. Level N = apps whose
    dependencies all live in levels < N. Returns a list of lists.

    Unlike install_order(), this preserves the dependency relationship when
    the caller installs one level at a time: every app in level N is only
    started after every app in levels < N has installed and its lifecycle
    hook has returned successfully.

    With strict=True (the bootstrap path) a missing dependency or a
    dependency cycle raises ValueError instead of silently downgrading the
    ordering guarantee. A cycle would otherwise install the cycle members
    CONCURRENTLY - exactly the ordering violation the level mechanism
    exists to prevent.
    """
    by_name = {name: cfg for name, cfg in apps}
    deps = {}
    for name, cfg in apps:
        raw = list(cfg.get("app", {}).get("depends_on", []) or [])
        missing = [d for d in raw if d not in by_name]
        if missing and strict:
            raise ValueError(
                f"{name}: depends_on references unknown app(s): {', '.join(sorted(missing))}")
        deps[name] = [d for d in raw if d in by_name]
    levels = []
    done = set()
    remaining = dict(deps)
    while remaining:
        ready = sorted(n for n, d in remaining.items() if all(x in done for x in d))
        if not ready:
            if strict:
                raise ValueError(
                    "dependency cycle detected among: " + ", ".join(sorted(remaining.keys())))
            # Non-strict fallback: a single level so a bad manifest can
            # never deadlock the boot.
            levels.append(sorted(remaining.keys()))
            break
        levels.append(ready)
        for n in ready:
            done.add(n)
            remaining.pop(n, None)
    return levels

def artifact_path(cfg, name):
    adir  = os.path.join(BASE, "apps")
    fname = cfg.get("artifact", {}).get("file")
    if not fname:
        return None
    fname = _validate_basename(fname, "artifact.file")
    for trydir in (adir, os.path.join(BASE, "store")):
        p = os.path.join(trydir, fname)
        if os.path.exists(p):
            return p
    return os.path.join(adir, fname)

def store_dir_for(cfg, name):
    fname = cfg.get("artifact", {}).get("file", "")
    if not fname:
        return None
    fname = _validate_basename(fname, "artifact.file")
    stem  = fname[:-len(".tar.zst")] if fname.endswith(".tar.zst") else fname
    return os.path.join(STORE_OPT, stem) if stem else None

